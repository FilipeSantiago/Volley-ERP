# =========================
# Core App
# =========================
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# =========================
# Google Auth Credentials
# =========================
# Preferred for local development:
# 1) gcloud auth application-default login
# 2) set GOOGLE_AUTH_MODE=adc (default behavior)
GOOGLE_AUTH_MODE=adc
# Optional fallback for non-interactive/service-account environments:
# Option 1: raw JSON string (single line)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option 2: path to service account json file
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# =========================
# Firestore
# =========================
FIRESTORE_DATABASE_ID=customer
FIRESTORE_USERS_COLLECTION=users
FIRESTORE_GOOGLE_CONNECTIONS_COLLECTION=google_connections
FIRESTORE_ORGANIZATIONS_COLLECTION=organizations
FIRESTORE_USER_ORGANIZATIONS_COLLECTION=user_organizations

# =========================
# Google OAuth (Web)
# =========================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# =========================
# Google OAuth (Mobile)
# =========================
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_SECRET=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_SECRET=

# =========================
# Auth / JWT
# =========================
AUTH_STATE_SECRET=change-me-auth-state-secret
JWT_ACCESS_SECRET=change-me-jwt-access-secret-minimum-32-bytes
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-minimum-32-bytes
JWT_ISSUER=volley-erp
JWT_AUDIENCE=volley-erp-client
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=604800

# =========================
# Redirect / Platform allowlists (comma-separated)
# =========================
AUTH_REDIRECT_ALLOWED_ORIGINS=http://localhost:3000
AUTH_REDIRECT_ALLOWED_SCHEMES=myapp
AUTH_MOBILE_ALLOWED_PLATFORMS=android,ios
AUTH_MOBILE_REDIRECT_ALLOWED_ANDROID=com.example.android:/oauth2redirect
AUTH_MOBILE_REDIRECT_ALLOWED_IOS=com.example.ios:/oauth2redirect

# =========================
# Refresh Token Encryption
# =========================
# If TOKEN_ENC_KEY_SECRET_NAME is set and resolvable, it can be used instead.
TOKEN_ENC_KEY=change-me-token-encryption-key
TOKEN_ENC_KEY_SECRET_NAME=

# =========================
# Invites
# =========================
INVITE_TOKEN_TTL_SECONDS=604800
APP_PUBLIC_BASE_URL=http://localhost:3000
